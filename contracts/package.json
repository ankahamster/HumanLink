{
  "name": "humanlink-contracts",
  "version": "1.0.0",
  "description": "Hardhat workspace for the HumanLink Sepolia contracts.",
  "private": true,
  "scripts": {
    "clean": "hardhat clean",
    "compile": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat compile",
    "test": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat test",
    "deploy:localhost": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy.js --network localhost",
    "deploy:sepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/deploy.js --network sepolia",
    "anchor:localhost": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/recordAssertionAudit.js --network localhost",
    "anchor:sepolia": "HARDHAT_DISABLE_TELEMETRY_PROMPT=true hardhat run scripts/recordAssertionAudit.js --network sepolia"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.26.3"
  }
}
