# Sepolia RPC endpoint, for example Alchemy / Infura / public RPC
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY

# Private key used by Hardhat for deployment and audit anchoring
SEPOLIA_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Optional: used for etherscan verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Optional: use a separate contract admin instead of the deployer wallet
CONTRACT_ADMIN=0x0000000000000000000000000000000000000000

# Optional: reuse an already deployed AssertionStatusRegistry
ASSERTION_STATUS_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
